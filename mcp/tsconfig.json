{
  "compilerOptions": {
    "target": "ES2021",
    "module": "nodenext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
