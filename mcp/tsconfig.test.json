{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    "typeRoots": ["../node_modules/@types"],
    "types": ["mocha", "chai", "node"]
  },
  "include": ["src/handler.ts", "src/policy.ts", "test/**/*.ts"]
}
