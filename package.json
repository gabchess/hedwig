{
  "license": "MIT",
  "scripts": {
    "public:check": "bash scripts/check-public-boundary.sh",
    "public:test": "bash scripts/test-public-boundary.sh",
    "evals": "node evals/run.js --offline",
    "evals:offline": "node evals/run.js --offline",
    "evals:judge": "node evals/run.js --judge",
    "evals:test": "node --test evals/test/*.test.js",
    "lint:fix": "prettier \"**/*.{js,ts}\" --write",
    "lint": "prettier \"**/*.{js,ts}\" --check",
    "sdk:typecheck": "tsc -p sdk/tsconfig.json --noEmit && tsc -p sdk/tsconfig.test.json --noEmit",
    "sdk:test": "ts-mocha -p sdk/tsconfig.test.json \"sdk/test/**/*.test.ts\"",
    "sdk:build": "tsc -p sdk/tsconfig.json",
    "consult:typecheck": "tsc -p consult/tsconfig.json --noEmit && tsc -p consult/tsconfig.test.json --noEmit",
    "consult:test": "ts-mocha -p consult/tsconfig.test.json \"consult/test/**/*.test.ts\""
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.3.4",
    "mocha": "^11",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
