    "assertions": [
      {
        "type": "rustProgramFunctionsEqual",
        "path": "programs/hedwig_sol/src/lib.rs",
        "expected": [
          "create_org",
          "create_role",
          "assign_role",
          "revoke_role",
          "check_role",
          "set_role_enabled"
        ]
      },
      {
        "type": "documentedExports",
        "language": "rust",
        "docsPath": "README.md",
        "sourcePath": "programs/hedwig_sol/src/lib.rs",
        "expected": [
          "create_org",
          "create_role",
          "assign_role",
          "revoke_role",
          "check_role",
          "set_role_enabled"
        ]
      },
      {
        "type": "contains",
        "path": "sdk/README.md",
        "values": [
          "build/send pairs",
          "createOrg",
          "createRole",
          "assignRole",
          "checkRole",
          "revokeRole",
          "setRoleEnabled"
        ]
      },
      {
        "type": "typescriptExportsEqual",
        "path": "sdk/src/index.ts",
        "expected": [
          "AssignRoleInput",
          "CheckRoleInput",
          "CreateOrgInput",
          "CreateRoleInput",
          "ExpiresAtInput",
          "HEDWIG_PROGRAM_ID",
          "HedwigSol",
          "NO_EXPIRY",
          "RevokeRoleInput",
          "SendInstructionOptions",
          "SetRoleEnabledInput",
          "assertOrgName",
          "assertRoleName",
          "buildAssignRoleInstruction",
          "buildCheckRoleInstruction",
          "buildCreateOrgInstruction",
          "buildCreateRoleInstruction",
          "buildRevokeRoleInstruction",
          "buildSetRoleEnabledInstruction",
          "createHedwigProgram",
          "deriveMemberPda",
          "deriveOrgPda",
          "deriveRolePda",
          "sendAssignRole",
          "sendCheckRole",
          "sendCreateOrg",
          "sendCreateRole",
          "sendRevokeRole",
          "sendSetRoleEnabled",
          "toExpiresAt"
        ]
      },
      {
        "type": "contains",
        "path": "docs/access-control/integration-guide.md",
        "values": [
          "Program<'info, hedwig_sol::program::HedwigSol>",
          "hedwig_sol::cpi::check_role",
          "It is a repository-local package and has not been published to npm."
        ]
