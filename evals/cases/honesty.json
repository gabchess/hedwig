[
  {
    "id": "network-stage-is-devnet",
    "category": "network",
    "claim": "Hedwig ships a reviewed devnet role record; mainnet and external adoption remain unverified future gates.",
    "assertions": [
      {
        "type": "contains",
        "path": "README.md",
        "values": [
          "This first onchain piece runs on Solana devnet.",
          "An external security review and a multisig transfer remain open gates before mainnet.",
          "No signed pilot, design partner, customer, revenue, production use, or external adoption has been verified."
        ]
      },
      {
        "type": "contains",
        "path": "SECURITY.md",
        "values": [
          "No mainnet release or bug bounty exists."
        ]
      },
      {
        "type": "contains",
        "path": "docs/agent-access/integration-proof.md",
        "values": [
          "This is a design boundary for future integration work.",
          "No external team, customer, production use, or independent adoption has been verified."
        ]
      },
      {
        "type": "excludes",
        "paths": [
          "README.md",
          "SECURITY.md",
          "docs/history/2026-07-shared-authorization-pilot.md",
          "app/README.md",
          "docs/agent-access/README.md",
          "docs/agent-access/integration-proof.md",
          "docs/agent-access/reference-flow.md"
        ],
        "values": [
          "Hedwig is mainnet-ready",
          "Hedwig is production-ready",
          "live on mainnet",
          "verified customer adoption"
        ]
      },
      {
        "type": "excludesPatterns",
        "paths": [
          "README.md",
          "ROADMAP.md",
          "SECURITY.md",
          "THREAT-MODEL.md",
          "app/README.md",
          "sdk/README.md",
          "docs/access-control/architecture.md",
          "docs/grants/progress.md",
          "docs/access-control/integration-guide.md",
          "docs/deployment/operations.md",
          "docs/history/2026-07-shared-authorization-pilot.md",
          "docs/history/2026-07-29-pilot-preparation.md",
          "docs/deployment/evidence/2026-07-24-consumer-devnet-integration.md",
          "docs/deployment/evidence/2026-07-24-devnet-promotion.md",
          "docs/security/reviews/2026-07-24-full-audit.md",
          "docs/agent-access/README.md",
          "docs/agent-access/integration-proof.md",
          "docs/agent-access/reference-flow.md"
        ],
        "patterns": [
          "\\b(?:is|now|currently)\\s+(?:fully\\s+)?mainnet[- ]ready\\b",
          "\\b(?:is|now|currently)\\s+ready\\s+for\\s+mainnet\\b",
          "\\b(?:is|now|currently)\\s+(?:fully\\s+)?production[- ]ready\\b",
          "\\b(?:is|now|currently)\\s+ready\\s+for\\s+production\\b",
          "\\b(?:is|has been|was)\\s+(?:independently\\s+|externally\\s+)?audited\\b",
          "\\bguarante(?:ed|es)\\s+(?:security|safety)\\b",
          "\\bverified\\s+(?:customer|external)\\s+adoption\\b",
          "\\blive\\s+production\\s+(?:spend|spending|funds|path)\\b"
        ]
      }
    ]
  },
  {
    "id": "security-posture-stays-bounded",
    "category": "security",
    "claim": "Tests and devnet evidence do not replace an external review, guarantee security, or remove upgrade-authority and caller-authentication risks.",
    "assertions": [
      {
        "type": "contains",
        "path": "THREAT-MODEL.md",
        "values": [
          "Hedwig has not completed an external security review.",
          "not a substitute for one.",
          "It does not prove that the transaction caller controls that pubkey",
          "This is the highest current deployment risk.",
          "not independent production use or mainnet safety."
        ]
      },
      {
        "type": "contains",
        "path": "SECURITY.md",
        "values": [
          "Hedwig is a devnet-stage program.",
          "The repository-local SDK alpha remains a repository test surface and is not published."
        ]
      },
      {
        "type": "excludes",
        "paths": [
          "README.md",
          "SECURITY.md",
          "THREAT-MODEL.md",
          "docs/access-control/integration-guide.md",
          "docs/history/2026-07-shared-authorization-pilot.md"
        ],
        "values": [
          "audited by a security firm",
          "externally audited and secure",
          "guaranteed secure",
          "eliminates all security risk"
        ]
      }
    ]
  },
  {
